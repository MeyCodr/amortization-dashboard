# ── Database ──────────────────────────────────────────────────────────────────
# MySQL connection string
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://root:password@localhost:3306/amortization_dashboard"

# ── Session ───────────────────────────────────────────────────────────────────
# Must be at least 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET="change-me-to-a-random-64-character-hex-string"

# Set to "true" when serving over HTTPS in production
COOKIE_SECURE="false"

# ── Email (SMTP) ───────────────────────────────────────────────────────────────
# Used for: password reset emails, account approval notifications
#
# Outlook / Microsoft 365:
SMTP_HOST="smtp.office365.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="your-email@yourdomain.com"
SMTP_PASSWORD="your-email-password"
SMTP_FROM="your-email@yourdomain.com"
#
# Gmail (requires an App Password if 2FA is enabled):
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_SECURE="false"
# SMTP_USER="your-email@gmail.com"
# SMTP_PASSWORD="your-app-password"
# SMTP_FROM="your-email@gmail.com"

# ── App URL ────────────────────────────────────────────────────────────────────
# Used to build links in emails (e.g. password reset link)
# Change to your server IP or domain in production
APP_URL="http://localhost:3003"
